# ============================================================
# Variables de entorno - Backend KYC Seguros Latina
# Copiar a .env y completar los valores reales
# ============================================================

PORT=3001
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_URL=postgresql://kyc_user:kyc_password@localhost:5432/kyc_db

# Registro Civil API (mock en v1, reemplazar con URL real)
REGISTRO_CIVIL_API_URL=https://api.registrocivil.gob.ec
REGISTRO_CIVIL_API_KEY=your_registro_civil_api_key_here

# OpenAI para validación de documentos
OPENAI_API_KEY=your_openai_api_key_here

# JWT para autenticación con el portal de Seguros Latina
JWT_SECRET=your_jwt_secret_here_change_in_production

# Almacenamiento local de archivos
STORAGE_PATH=./uploads

# ERP de Seguros Latina (mock en v1, reemplazar con URL real)
ERP_API_URL=https://erp.seguroslatina.com
ERP_API_KEY=your_erp_api_key_here
